{
  "headers": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "qube-solutions.vercel.app" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ],
  "redirects": [
    { "source": "/homework", "destination": "/project-brief", "permanent": true }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/((?!.*\\.).*)", "destination": "/index.html" }
  ]
}
